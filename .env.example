# Copy to .env and fill in. Never commit the real .env (already gitignored).

# --- Required ---
OPENAI_API_KEY=

# --- Synthesis model (optional) ---
# Defaults to gpt-5.5 (a few seconds/reply). gpt-5.5-pro is deeper reasoning
# at 30-90s/reply -- see README's "Model choice is deliberate" section.
OPENAI_MODEL=gpt-5.5

# --- RAG store (optional) ---
# Defaults to the local nix-local-rag Postgres instance.
RAGDB_URI=postgresql://mcp@127.0.0.1:5433/ragdb

# --- CRAG web fallback (optional) ---
# Without this, weak local retrieval just falls through to an honest
# "I don't have that info" instead of a live canada.ca search.
SERPER_API_KEY=

# --- WhatsApp pairing (optional) ---
# Digits only, no "+". Set to pair via phone-number code instead of QR.
PAIR_PHONE_NUMBER=

# --- Access control (optional but recommended once live) ---
# Comma-separated allowlist, digits only, e.g. 15145551234,16045557890.
# Unset = replies to anyone who messages the linked number.
ALLOWED_NUMBERS=

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# --- Re-crawl / ingest only (scripts/recrawl.js), not needed to run the bot ---
APIFY_TOKEN=

# --- scripts/inngest/serve.js only ---
INNGEST_SERVE_PORT=
